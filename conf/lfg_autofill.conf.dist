[worldserver]

###################################################################################################
# LFG AUTOFILL
#
# Fills the gaps in a party with playerbots before a Dungeon Finder queue goes out.
#
# Players set how many bodies they want with a chat command:
#
#   .lfgfill 5      fill my party to 5 before queueing
#   .lfgfill 3      fill to 3
#   .lfgfill off    stop filling
#   .lfgfill now    fill immediately, without queueing
#   .lfgfill        show the current setting
#
# The party size arrives over a chat command rather than a control on the Dungeon Finder
# pane because that pane is client-side FrameXML shipped in the 3.3.5a MPQ — the server
# cannot add a widget to it. The role half needs no input at all: the pane already sends
# the player's role checkboxes with the join packet, and the module reads them from there.
#
# Missing roles are worked out against the standard 5-man shape (one tank, one healer, the
# rest damage) using the roles the party already covers. Bot roles come from playerbots'
# own talent-spec classifier, so a protection warrior counts as a tank here exactly as it
# does to the bot AI.
###################################################################################################

#    LfgAutofill.Enable
#        Description: Enable the module.
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

LfgAutofill.Enable = 1

#    LfgAutofill.DefaultPartySize
#        Description: Party size used for players who have not run .lfgfill themselves.
#                     0 leaves autofill opt-in, which is the safer default: filling a
#                     party for someone who did not ask for it changes their run.
#        Default:     0  - (Opt-in; players choose with .lfgfill)
#        Values:      0, or 2-5

LfgAutofill.DefaultPartySize = 0

#    LfgAutofill.LevelsAbove
#        Description: How many levels above the queueing player a bot may be. Bots below
#                     the player's level are never taken, so the recruited party is always
#                     at or above whoever is filling it. 0 means exact level only, which
#                     fills poorly on a quiet server; wider values fill more reliably at
#                     the cost of the party outlevelling its own runs.
#        Default:     3

LfgAutofill.LevelsAbove = 3

#    LfgAutofill.CrossFaction
#        Description: Allow opposite-faction bots to be recruited. This roughly doubles the
#                     pool, which matters most in level bands where one faction has no
#                     healer-capable classes online at all.
#                     Has no effect unless the core's AllowTwoSide.Interaction.Group is
#                     also enabled: that setting is what makes a mixed party work at all,
#                     so the module defers to it rather than building a group the rest of
#                     the server does not expect.
#        Default:     1  - (Enabled where the core allows it)
#                     0  - (Same faction only)

LfgAutofill.CrossFaction = 1

#    LfgAutofill.Announce
#        Description: Tell the player which bots joined and in what role.
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

LfgAutofill.Announce = 1

#    LfgAutofill.BorrowFromSurplus
#        Description: When there are not enough bots in the recruitable band (the queueing
#                     player's level up to LevelsAbove over it), borrow bots from another
#                     level, re-level them to the player's level, and put them back on the
#                     level they came from when they leave the party.
#
#                     This is a fallback, never a first choice: it only runs for slots that
#                     could not be filled from bots already in the band, so on a server with
#                     a healthy pool at the player's level it never fires. That is what makes
#                     it safe to leave on.
#
#                     Donors are taken from the bracket that CONTAINS the player's level
#                     first, which is census-neutral: taking a level 67 bot down to a level
#                     60 player leaves it inside 60-69, so mod-player-bot-level-brackets has
#                     nothing to correct afterwards. Only once that bracket is exhausted does
#                     anything move between brackets, and then donors are taken in order of
#                     surplus against that module's configured targets. Bracket definitions
#                     are read from its configuration, so the two cannot drift apart.
#
#                     Because a re-level is spread over several world ticks, a queue press
#                     that borrows waits for the bots to land before the join goes out — the
#                     player sees "re-levelling N bot(s); queueing when they arrive", then
#                     the usual queue pop. See BorrowTimeoutMs for the give-up point.
#
#                     Note this is a re-roll, not a loan of a specific character build:
#                     PlayerbotFactory rebuilds skills, spells, talents and gear from scratch
#                     in both directions, and a bot borrowed as a healer can land as damage.
#                     A landed bot that would break the LFG role check is released rather
#                     than added, because an invalid party kills the whole queue silently.
#        Default:     1  - (Enabled)
#                     0  - (Disabled; short fills stay short)

LfgAutofill.BorrowFromSurplus = 1

#    LfgAutofill.MaxBorrowPerFill
#        Description: Ceiling on how many bots a single fill may borrow. A party is five, so
#                     four covers the worst case; the setting exists so no single fill can
#                     ever re-roll more than a party's worth of the bot population.
#        Default:     4

LfgAutofill.MaxBorrowPerFill = 4

#    LfgAutofill.BorrowIntervalMs
#        Description: Milliseconds between queued re-levels. PlayerbotFactory::Randomize
#                     tears down and rebuilds a character across roughly eighteen phases;
#                     doing several inline would hitch the world thread, so they are spread
#                     one per interval. Lower fills faster at the cost of a heavier tick.
#        Default:     250

LfgAutofill.BorrowIntervalMs = 250

#    LfgAutofill.BorrowTimeoutMs
#        Description: How long a queue press waits for its borrowed bots before going out
#                     with whoever has landed. Stragglers (usually a donor that logged out
#                     or is stuck in combat) are cancelled and sent home, and the queue is
#                     issued with the party as it stands.
#        Default:     10000
